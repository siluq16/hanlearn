# Supabase Cloud DEVELOPMENT project only. Copy to .env.local and fill locally.
# Both values below are public configuration, never use a service-role/secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# No database password, access token or server secret is required by the app.
# Sprint 2.2 server-only opt-in; still rejects every non-literal-loopback target.
# Leave disabled for the configured Cloud Development project.
HANLEARN_LOCAL_STUDY_CONFIRMATION=0

# Server-only opt-in; accepts only hhgxrjqkuwdgurphopok, never Production.
HANLEARN_DEVELOPMENT_LEARNING=0

