{
  "name": "hanlearn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:lessons:browser": "playwright test --config playwright.lessons.config.ts",
    "test:lessons:catalog": "node scripts/check-lesson-catalog.mjs",
    "content": "npm run content:validate",
    "content:validate": "node --experimental-strip-types scripts/validate-pilot.mjs",
    "test:contracts": "node scripts/check-contracts.mjs",
    "test:db:native": "powershell -NoProfile -File scripts/test-native.ps1",
    "test:security": "node scripts/check-security.mjs",
    "db:types": "node --env-file-if-exists=.env.cloud-test.local scripts/generate-types.mjs",
    "test:cloud": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.cloud-test.local scripts/check-cloud.mjs",
    "format:check": "prettier --check src tests next.config.ts playwright.config.ts playwright.lessons.config.ts vitest.config.ts",
    "content:import:plan": "node --experimental-strip-types scripts/pilot-r3-importer.mjs --preview",
    "test:importer:native": "powershell -NoProfile -File scripts/test-pilot-importer-native.ps1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "supabase": "3.1.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
