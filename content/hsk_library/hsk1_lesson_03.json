        {
          "id": "gp-03-2",
          "titleVi": "Phân biệt số đếm 二 (èr) và 两 (liǎng)",
          "pattern": "两 + Lượng từ + Danh từ",
          "explanationVi": "Khi nói số lượng trước lượng từ (như 个, 口, 只), dùng 两 thay vì 二 (ví dụ: 两个, 两口人).",
          "examples": [
            {
