            {
              "hanzi": "你家有几口人？",
              "pinyin": "Nǐ jiā yǒu jǐ kǒu rén?",
              "translationVi": "Nhà bạn có mấy người?"
            },
            {
              "hanzi": "我家有四口人。",
              "pinyin": "Wǒ jiā yǒu sì kǒu rén.",
              "translationVi": "Nhà tôi có bốn người."
            }
          ]
