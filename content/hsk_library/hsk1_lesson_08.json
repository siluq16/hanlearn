      "grammar_points": [
        {
          "id": "g-08-1",
          "titleVi": "1. Trợ động từ biểu thị ý muốn: 想 (xiǎng) + Động từ",
          "pattern": "Chủ ngữ + 想 + V + Tân ngữ",
          "explanationVi": "'想' đặt trước động từ biểu thị ý định, mong muốn làm việc gì. Thể phủ định là '不想'.",
          "examples": [
            {
              "hanzi": "我想吃中国菜。",
              "pinyin": "Wǒ xiǎng chī Zhōngguó cài.",
              "translationVi": "Tôi muốn ăn món Trung Quốc."
            },
            {
              "hanzi": "你想要喝什么？",
              "pinyin": "Nǐ xiǎng yào hē shénme?",
              "translationVi": "Bạn muốn uống cái gì?"
            }
          ]
        },
        {
          "id": "g-08-2",
          "titleVi": "2. Cấu trúc diễn đạt sở thích: 喜欢 (xǐhuan) + N / V",
          "pattern": "Chủ ngữ + 喜欢 + Danh từ / Động từ",
          "explanationVi": "Dùng để diễn tả sự yêu thích đối với đồ vật, món ăn hoặc hành động cụ thể. Phủ định là '不喜欢'.",
          "examples": [
            {
              "hanzi": "我喜欢喝中国茶。",
              "pinyin": "Wǒ xǐhuan hē Zhōngguó chá.",
              "translationVi": "Tôi thích uống trà Trung Quốc."
            },
            {
              "hanzi": "他不喜欢吃面条儿。",
              "pinyin": "Tā bù xǐhuan chī miàntiáor.",
              "translationVi": "Anh ấy không thích ăn mì sợi."
            }
          ]
        }
      ]
    },
